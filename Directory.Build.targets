<Project>
  <Target Name="CollectEmbeddedPowerShell" BeforeTargets="GetCopyToOutputDirectoryItems;ComputeFilesToPublish;_GetPackageFiles" Condition="'$(CopyEmbeddedPowerShell)' == 'true'">
    <MSBuild Projects="$(MSBuildThisFileDirectory)src/AllAgent.NET.PowerShell/AllAgent.NET.PowerShell.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier)" RemoveProperties="TargetFramework">
      <Output TaskParameter="TargetOutputs" ItemName="EmbeddedPowerShellTarget" />
    </MSBuild>
    <PropertyGroup><EmbeddedPowerShellDirectory>@(EmbeddedPowerShellTarget->'%(RootDir)%(Directory)')</EmbeddedPowerShellDirectory></PropertyGroup>
    <Error Condition="!Exists('$(EmbeddedPowerShellDirectory)AllAgent.NET.PowerShell.dll')" Text="Bundled PowerShell SDK worker is missing." />
    <ItemGroup>
      <EmbeddedPowerShellFiles Include="$(EmbeddedPowerShellDirectory)**/*" Exclude="$(EmbeddedPowerShellDirectory)**/ref/**;$(EmbeddedPowerShellDirectory)**/runtimes/linux*/**;$(EmbeddedPowerShellDirectory)**/runtimes/osx*/**;$(EmbeddedPowerShellDirectory)**/runtimes/android*/**;$(EmbeddedPowerShellDirectory)**/runtimes/maccatalyst*/**;$(EmbeddedPowerShellDirectory)**/*.pdb;$(EmbeddedPowerShellDirectory)**/*.so;$(EmbeddedPowerShellDirectory)**/*.dylib" />
      <Content Include="@(EmbeddedPowerShellFiles)">
        <Link>powershell/%(RecursiveDir)%(Filename)%(Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <Pack Condition="'$(MSBuildProjectName)' == 'AllAgent.NET.Core'">true</Pack>
        <Pack Condition="'$(MSBuildProjectName)' != 'AllAgent.NET.Core'">false</Pack>
        <BuildAction>None</BuildAction>
        <PackagePath>contentFiles/any/$(TargetFramework)/powershell/%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
        <PackageCopyToOutput>true</PackageCopyToOutput>
      </Content>
    </ItemGroup>
  </Target>
  <Target Name="CopyEmbeddedPowerShellFiles" AfterTargets="Build" DependsOnTargets="CollectEmbeddedPowerShell" Condition="'$(CopyEmbeddedPowerShell)' == 'true'">
    <Copy SourceFiles="@(EmbeddedPowerShellFiles)" DestinationFiles="@(EmbeddedPowerShellFiles->'$(OutDir)powershell/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishEmbeddedPowerShellFiles" AfterTargets="ComputeFilesToPublish" DependsOnTargets="CollectEmbeddedPowerShell" Condition="'$(CopyEmbeddedPowerShell)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Include="@(EmbeddedPowerShellFiles)">
        <RelativePath>powershell/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
  <Target Name="CopyBrowserWorkerFiles" AfterTargets="Build" Condition="'$(CopyBrowserWorker)' == 'true'">
    <MSBuild Projects="$(MSBuildThisFileDirectory)src/AllAgent.NET.Browser/AllAgent.NET.Browser.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier)" RemoveProperties="TargetFramework">
      <Output TaskParameter="TargetOutputs" ItemName="BrowserWorkerTarget" />
    </MSBuild>
    <PropertyGroup><BrowserWorkerBuildDirectory>@(BrowserWorkerTarget->'%(RootDir)%(Directory)')</BrowserWorkerBuildDirectory></PropertyGroup>
    <Error Condition="'$(BrowserWorkerBuildDirectory)' == '' or !Exists('$(BrowserWorkerBuildDirectory)AllAgent.NET.Browser.dll')" Text="WebView2 browser worker is missing; build its project before copying." />
    <ItemGroup><BrowserWorkerFiles Include="$(BrowserWorkerBuildDirectory)**/*" /></ItemGroup>
    <Copy SourceFiles="@(BrowserWorkerFiles)" DestinationFiles="@(BrowserWorkerFiles->'$(OutDir)browser/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="IncludeBrowserWorkerPublishFiles" AfterTargets="ComputeFilesToPublish" Condition="'$(CopyBrowserWorker)' == 'true'">
    <PropertyGroup><BrowserWorkerPublishDirectory>$(MSBuildProjectDirectory)/obj/$(Configuration)/$(TargetFramework)/browser-publish/</BrowserWorkerPublishDirectory></PropertyGroup>
    <MSBuild Projects="$(MSBuildThisFileDirectory)src/AllAgent.NET.Browser/AllAgent.NET.Browser.csproj" Targets="Publish" RemoveProperties="TargetFramework" Properties="TargetFramework=net10.0-windows;Configuration=$(Configuration);PublishDir=$(BrowserWorkerPublishDirectory);CopyBrowserWorker=false;PublishSingleFile=false;SelfContained=$(SelfContained);RuntimeIdentifier=$(RuntimeIdentifier)" />
    <ItemGroup>
      <BrowserWorkerPublishFiles Include="$(BrowserWorkerPublishDirectory)**/*" Exclude="$(BrowserWorkerPublishDirectory)**/everything/**;$(BrowserWorkerPublishDirectory)**/ref/**;$(BrowserWorkerPublishDirectory)**/runtimes/linux*/**;$(BrowserWorkerPublishDirectory)**/runtimes/osx*/**;$(BrowserWorkerPublishDirectory)**/*.pdb;$(BrowserWorkerPublishDirectory)**/*.so;$(BrowserWorkerPublishDirectory)**/*.dylib" />
      <ResolvedFileToPublish Include="@(BrowserWorkerPublishFiles)">
        <RelativePath>browser/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
  <Target Name="CopyGuiShellFiles" AfterTargets="Build" Condition="'$(CopyGuiShell)' == 'true'">
    <MSBuild Projects="$(MSBuildThisFileDirectory)src/AllAgent.NET.Gui/AllAgent.NET.Gui.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier)" RemoveProperties="TargetFramework">
      <Output TaskParameter="TargetOutputs" ItemName="GuiShellTarget" />
    </MSBuild>
    <PropertyGroup><GuiShellBuildDirectory>@(GuiShellTarget->'%(RootDir)%(Directory)')</GuiShellBuildDirectory></PropertyGroup>
    <Error Condition="'$(GuiShellBuildDirectory)' == '' or !Exists('$(GuiShellBuildDirectory)AllAgent.NET.Gui.dll')" Text="WPF GUI shell is missing; build its project before copying." />
    <ItemGroup><GuiShellFiles Include="$(GuiShellBuildDirectory)**/*" /></ItemGroup>
    <Copy SourceFiles="@(GuiShellFiles)" DestinationFiles="@(GuiShellFiles->'$(OutDir)gui/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="IncludeGuiShellPublishFiles" AfterTargets="ComputeFilesToPublish" Condition="'$(CopyGuiShell)' == 'true'">
    <PropertyGroup><GuiShellPublishDirectory>$(MSBuildProjectDirectory)/obj/$(Configuration)/$(TargetFramework)/gui-publish/</GuiShellPublishDirectory></PropertyGroup>
    <MSBuild Projects="$(MSBuildThisFileDirectory)src/AllAgent.NET.Gui/AllAgent.NET.Gui.csproj" Targets="Publish" RemoveProperties="TargetFramework" Properties="TargetFramework=net10.0-windows;Configuration=$(Configuration);PublishDir=$(GuiShellPublishDirectory);CopyGuiShell=false;PublishSingleFile=false;SelfContained=$(SelfContained);RuntimeIdentifier=$(RuntimeIdentifier)" />
    <ItemGroup>
      <GuiShellPublishFiles Include="$(GuiShellPublishDirectory)**/*" Exclude="$(GuiShellPublishDirectory)**/everything/**;$(GuiShellPublishDirectory)**/ref/**;$(GuiShellPublishDirectory)**/runtimes/linux*/**;$(GuiShellPublishDirectory)**/runtimes/osx*/**;$(GuiShellPublishDirectory)**/*.pdb;$(GuiShellPublishDirectory)**/*.so;$(GuiShellPublishDirectory)**/*.dylib" />
      <ResolvedFileToPublish Include="@(GuiShellPublishFiles)">
        <RelativePath>gui/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
  <Target Name="CopyComputerWorkerFiles" AfterTargets="Build" Condition="'$(CopyComputerWorker)' == 'true'">
    <MSBuild Projects="$(MSBuildThisFileDirectory)src/AllAgent.NET.ComputerUse/AllAgent.NET.ComputerUse.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier)" RemoveProperties="TargetFramework">
      <Output TaskParameter="TargetOutputs" ItemName="ComputerWorkerTarget" />
    </MSBuild>
    <PropertyGroup><ComputerWorkerBuildDirectory>@(ComputerWorkerTarget->'%(RootDir)%(Directory)')</ComputerWorkerBuildDirectory></PropertyGroup>
    <Error Condition="'$(ComputerWorkerBuildDirectory)' == '' or !Exists('$(ComputerWorkerBuildDirectory)AllAgent.NET.ComputerUse.dll')" Text="Computer worker build output is missing; build its project before copying." />
    <ItemGroup>
      <!-- Old build directories may still contain the withdrawn sidecar. Never propagate it. -->
      <ComputerWorkerFiles Include="$(ComputerWorkerBuildDirectory)**/*" Exclude="$(ComputerWorkerBuildDirectory)pi/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(ComputerWorkerFiles)" DestinationFiles="@(ComputerWorkerFiles->'$(OutDir)computer/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="IncludeComputerWorkerPublishFiles" AfterTargets="ComputeFilesToPublish" Condition="'$(CopyComputerWorker)' == 'true'">
    <PropertyGroup><ComputerWorkerPublishDirectory>$(MSBuildProjectDirectory)/obj/$(Configuration)/$(TargetFramework)/computer-publish/</ComputerWorkerPublishDirectory></PropertyGroup>
    <MSBuild Projects="$(MSBuildThisFileDirectory)src/AllAgent.NET.ComputerUse/AllAgent.NET.ComputerUse.csproj" Targets="Publish" RemoveProperties="TargetFramework" Properties="TargetFramework=net10.0-windows;Configuration=$(Configuration);PublishDir=$(ComputerWorkerPublishDirectory);CopyComputerWorker=false;PublishSingleFile=false;SelfContained=$(SelfContained);RuntimeIdentifier=$(RuntimeIdentifier)" />
    <ItemGroup>
      <ComputerWorkerPublishFiles Include="$(ComputerWorkerPublishDirectory)**/*" Exclude="$(ComputerWorkerPublishDirectory)pi/**/*;$(ComputerWorkerPublishDirectory)**/everything/**;$(ComputerWorkerPublishDirectory)**/ref/**;$(ComputerWorkerPublishDirectory)**/runtimes/linux*/**;$(ComputerWorkerPublishDirectory)**/runtimes/osx*/**;$(ComputerWorkerPublishDirectory)**/*.pdb;$(ComputerWorkerPublishDirectory)**/*.so;$(ComputerWorkerPublishDirectory)**/*.dylib" />
      <ResolvedFileToPublish Include="@(ComputerWorkerPublishFiles)">
        <RelativePath>computer/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
  <Target Name="CopyAgentSandboxFiles" AfterTargets="Build" Condition="'$(CopyAgentSandbox)' == 'true'">
    <MSBuild Projects="$(MSBuildThisFileDirectory)src/AllAgent.NET.Sandbox/AllAgent.NET.Sandbox.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier)" RemoveProperties="TargetFramework">
      <Output TaskParameter="TargetOutputs" ItemName="AgentSandboxTarget" />
    </MSBuild>
    <PropertyGroup>
      <AgentSandboxBuildDirectory>@(AgentSandboxTarget->'%(RootDir)%(Directory)')</AgentSandboxBuildDirectory>
    </PropertyGroup>
    <Error Condition="'$(AgentSandboxBuildDirectory)' == '' or !Exists('$(AgentSandboxBuildDirectory)AllAgent.NET.Sandbox.dll')" Text="Hyperlight worker build output is missing; build its project before copying." />
    <ItemGroup>
      <AgentSandboxFiles Include="$(AgentSandboxBuildDirectory)**/*" Exclude="$(AgentSandboxBuildDirectory)pi/**/*;$(AgentSandboxBuildDirectory)win-x64/**/*;$(AgentSandboxBuildDirectory)linux-x64/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(AgentSandboxFiles)" DestinationFiles="@(AgentSandboxFiles->'$(OutDir)sandbox/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishAgentSandboxFiles" AfterTargets="Publish" Condition="'$(CopyAgentSandbox)' == 'true'">
    <MSBuild Projects="$(MSBuildThisFileDirectory)src/AllAgent.NET.Sandbox/AllAgent.NET.Sandbox.csproj" Targets="Publish" Properties="Configuration=$(Configuration);PublishDir=$(PublishDir)sandbox/;CopyAgentSandbox=false;PublishSingleFile=false;RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained)" />
  </Target>
</Project>
