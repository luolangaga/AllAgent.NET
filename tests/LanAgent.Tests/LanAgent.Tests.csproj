<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <CopyEmbeddedPowerShell>true</CopyEmbeddedPowerShell>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <CopyAgentSandbox>true</CopyAgentSandbox>
    <CopyBrowserWorker>true</CopyBrowserWorker>
    <CopyComputerWorker>true</CopyComputerWorker>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/LanAgent.Browser/LanAgent.Browser.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" SetTargetFramework="TargetFramework=net10.0-windows" />
    <ProjectReference Include="../../src/LanAgent.ComputerUse/LanAgent.ComputerUse.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" SetTargetFramework="TargetFramework=net10.0-windows" />
    <ProjectReference Include="../LanAgent.ComputerUseFixture/LanAgent.ComputerUseFixture.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" SetTargetFramework="TargetFramework=net10.0-windows" />
    <ProjectReference Include="../../plugins/LanAgent.CommandCode/LanAgent.CommandCode.csproj" />
    <ProjectReference Include="../../plugins/LanAgent.WorkBuddy/LanAgent.WorkBuddy.csproj" />
    <ProjectReference Include="../../plugins/LanAgent.Diligence/LanAgent.Diligence.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" PrivateAssets="all" />
    <ProjectReference Include="../../src/LanAgent.Core/LanAgent.Core.csproj" />
    <ProjectReference Include="../../samples/LanAgent.SamplePlugin/LanAgent.SamplePlugin.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/LanAgent.Sandbox/LanAgent.Sandbox.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../LanAgent.ProcessProbe/LanAgent.ProcessProbe.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/LanAgent.Terminal/LanAgent.Terminal.csproj" />
    <PackageReference Include="Spectre.Console.Testing" Version="0.57.2" />
    <ProjectReference Include="../../src/LanAgent.ToolGenerator/LanAgent.ToolGenerator.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>
  <Target Name="CopyProcessProbe" AfterTargets="Build">
    <ItemGroup><ProbeFiles Include="../LanAgent.ProcessProbe/bin/$(Configuration)/net10.0/*" /></ItemGroup>
    <Copy SourceFiles="@(ProbeFiles)" DestinationFolder="$(OutDir)probe" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopySamplePlugin" AfterTargets="Build">
    <ItemGroup><PluginFiles Include="../../samples/LanAgent.SamplePlugin/bin/$(Configuration)/net10.0/LanAgent.SamplePlugin.dll" /><PluginFiles Include="../../samples/LanAgent.SamplePlugin/lanagent-plugin.json" /></ItemGroup>
    <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(OutDir)sample-plugin" SkipUnchangedFiles="true" />
  </Target>
</Project>
