<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <CopyEmbeddedPowerShell>true</CopyEmbeddedPowerShell>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.1.0</Version>
    <Authors>AllAgent.NET</Authors>
    <PackageTags>AllAgent.NET;Agent;CodeAct;PluginSDK</PackageTags>
    <Description>AllAgent.NET host SDK and CodeAct agent runtime.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/luolangaga/AllAgent.NET</PackageProjectUrl>
    <RepositoryUrl>https://github.com/luolangaga/AllAgent.NET.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AllAgent.NET.PowerShell/AllAgent.NET.PowerShell.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="../AllAgent.NET.ToolGenerator/AllAgent.NET.ToolGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="../AllAgent.NET.ToolGenerator/bin/$(Configuration)/netstandard2.0/AllAgent.NET.ToolGenerator.dll" Pack="true" PackagePath="analyzers/dotnet/cs/" Visible="false" />
    <None Include="../../docs/plugin-development-beginner.zh-CN.md" Pack="true" PackagePath="/README.md" Visible="false" />
    <None Include="../../docs/plugins.zh-CN.md" Pack="true" PackagePath="/plugins.zh-CN.md" Visible="false" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" Visible="false" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="Runtime/Scripts/*" />
    <Content Include="Tools/Everything/**/*" Exclude="Tools/Everything/README.md">
      <Link>everything/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Pack>true</Pack>
      <PackagePath>contentFiles/any/$(TargetFramework)/everything/%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
      <PackageCopyToOutput>true</PackageCopyToOutput>
    </Content>
    <EmbeddedResource Include="Skills/computer-use/SKILL.md" LogicalName="AllAgent.NET.Core.Skills.computer-use.SKILL.md" />
    <EmbeddedResource Include="Skills/browser-use/SKILL.md" LogicalName="AllAgent.NET.Core.Skills.browser-use.SKILL.md" />
    <None Update="Browser/UPSTREAM-LICENSE.txt" Pack="true" PackagePath="/browser-use-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="Services/AI/models-catalog.json" />
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.81.0" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.OpenAI" Version="1.81.0" />
    <PackageReference Include="ModelContextProtocol" Version="1.3.0" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageReference Include="NuGet.Packaging" Version="7.9.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
    <!-- Pin the patched version above NuGet.Packaging's transitive minimum. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>


</Project>
