<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <SetTargetFramework>TargetFramework=net10.0-windows</SetTargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>AllAgent.NET.Gui</AssemblyName>
    <ApplicationIcon>..\AllAgent.NET.Terminal\Assets\allagent.ico</ApplicationIcon>
    <RootNamespace>AllAgent.NET.Gui</RootNamespace>
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
  </ItemGroup>
  <!-- The shell has no Core reference by design; the crash reporter is dependency-free BCL code. -->
  <ItemGroup>
    <Compile Include="..\AllAgent.NET.Core\Diagnostics\CrashReporter.cs" Link="Diagnostics\CrashReporter.cs" />
  </ItemGroup>
  <!-- Only the WPF WebView2 assembly is used; the WinForms wrapper and the
       default WinForms framework reference are never linked. -->
  <Target Name="RemoveUnusedWebViewFormsReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup><Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.WinForms'" /></ItemGroup>
  </Target>
</Project>
