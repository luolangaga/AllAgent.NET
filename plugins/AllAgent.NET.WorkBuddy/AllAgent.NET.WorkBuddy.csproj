<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <PackageId>AllAgent.NET.WorkBuddy</PackageId><Version>1.1.0</Version>
    <PackageTags>AllAgent.NET;LanAgent;WorkBuddy;Authentication;Automation</PackageTags>
    <Description>WorkBuddy browser login, streaming adapter, quota query and daily automation.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/AllAgent.NET.Core/AllAgent.NET.Core.csproj" PrivateAssets="all" />
    <None Include="allagent-plugin.json" Pack="true" PackagePath="allagent/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
