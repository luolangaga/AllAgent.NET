{
  "sdkVersion": 1,
  "assembly": "AllAgent.NET.CodeGraph.dll",
  "entryType": "AllAgent.NET.CodeGraph.CodeGraphPlugin",
  "web": {
    "sdkVersion": 1,
    "contributes": {
      "settings": [{
        "id": "codegraph",
        "title": "CodeGraph",
        "fields": [
          {
            "key": "path",
            "label": "codegraph 可执行文件路径",
            "type": "text",
            "placeholder": "留空自动检测",
            "description": "支持绝对路径；也可用环境变量 ALLAGENT_CODEGRAPH_PATH。"
          },
          {
            "key": "autosync",
            "label": "查询前自动同步索引",
            "type": "boolean",
            "default": "true",
            "description": "每次 explore 前增量同步，最多每 2 秒一次。"
          },
          {
            "key": "telemetry",
            "label": "允许 CodeGraph 匿名遥测",
            "type": "boolean",
            "default": "false",
            "description": "默认关闭；只包含工具使用与语言统计，不包含代码、路径或查询。"
          }
        ],
        "entry": "web/settings.html"
      }]
    }
  }
}
