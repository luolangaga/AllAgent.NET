{
  "sdkVersion": 1,
  "assembly": "AllAgent.NET.CodeGraph.dll",
  "entryType": "AllAgent.NET.CodeGraph.CodeGraphPlugin",
  "web": {
    "sdkVersion": 1,
    "contributes": {
      "settings": [{
        "id": "codegraph",
        "title": "CodeGraph",
        "fields": [
          {
            "key": "autosync",
            "label": "查询前自动增量索引",
            "type": "boolean",
            "default": "true",
            "description": "每次 explore 前检查文件变更并增量更新，最多每 2 秒一次。"
          }
        ],
        "entry": "web/settings.html"
      }]
    }
  }
}
