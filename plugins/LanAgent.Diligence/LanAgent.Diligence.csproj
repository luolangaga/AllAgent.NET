<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <PackageId>LanAgent.Diligence</PackageId>
    <Version>1.0.0</Version>
    <Authors>LanAgent</Authors>
    <Description>通过 /ext effort 切换 Agent 执行积极度：省力、标准、勤快。</Description>
    <PackageTags>LanAgent;Plugin;Agent;Prompt</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/luolangaga/LanAgent.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/LanAgent.Core/LanAgent.Core.csproj" PrivateAssets="all" />
    <None Include="lanagent-plugin.json" Pack="true" PackagePath="lanagent/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
