<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <PackageId>LanAgent.WorkBuddy</PackageId><Version>1.0.0</Version>
    <PackageTags>LanAgent;WorkBuddy;Authentication</PackageTags>
    <Description>WorkBuddy browser login, streaming adapter and quota query.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/LanAgent.Core/LanAgent.Core.csproj" PrivateAssets="all" />
    <None Include="lanagent-plugin.json" Pack="true" PackagePath="lanagent/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
