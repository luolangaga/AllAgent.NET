<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <PackageId>AllAgent.NET.GitHub</PackageId><Version>1.0.0</Version>
    <PackageTags>AllAgent.NET;LanAgent;GitHub;Issues;PullRequests</PackageTags>
    <Description>GitHub issues, pull requests, notifications and workspace-aware AI workflows.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/AllAgent.NET.Core/AllAgent.NET.Core.csproj" PrivateAssets="all" />
    <ProjectReference Include="../../src/AllAgent.NET.ToolGenerator/AllAgent.NET.ToolGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Update="allagent-plugin.json" Pack="true" PackagePath="allagent/" />
    <None Update="web/**/*" Pack="true" PackagePath="allagent/" />
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
