{
  "sdkVersion": 1,
  "assembly": "AllAgent.NET.GitHub.dll",
  "entryType": "AllAgent.NET.GitHub.GitHubPlugin",
  "web": {
    "sdkVersion": 1,
    "entry": "web/index.html",
    "capabilities": ["navigation", "workspace.switch", "workspace.pick", "clipboard.write", "markdown"],
    "contributes": {
      "panels": [{ "id": "github", "title": "GitHub", "icon": "github", "entry": "web/index.html", "order": 25 }],
      "commands": [{ "id": "open", "title": "GitHub · Issue、PR 与消息", "panel": "github" }]
    }
  }
}
