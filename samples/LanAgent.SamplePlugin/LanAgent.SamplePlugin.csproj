<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <PackageId>LanAgent.SamplePlugin</PackageId><Version>1.0.0</Version>
    <PackageTags>LanAgent;Sample;Tools;Hooks</PackageTags>
    <Authors>LanAgent</Authors><Description>LanAgent 通用 DLL 插件开发示例：工具、模型、命令和 Hooks。</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/LanAgent.Core/LanAgent.Core.csproj" PrivateAssets="all" />
    <ProjectReference Include="../../src/LanAgent.ToolGenerator/LanAgent.ToolGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="lanagent-plugin.json" Pack="true" PackagePath="lanagent/" />
    <None Include="../../docs/plugins.zh-CN.md" Pack="true" PackagePath="/README.md" />
  </ItemGroup>
</Project>
